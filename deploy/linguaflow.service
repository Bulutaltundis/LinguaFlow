[Unit]
Description=LinguaFlow FastAPI application
After=network.target

[Service]
User=linguaflow
Group=linguaflow
WorkingDirectory=/var/www/linguaflow
EnvironmentFile=/var/www/linguaflow/.env
ExecStart=/var/www/linguaflow/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
