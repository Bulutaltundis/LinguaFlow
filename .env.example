APP_ENV=production
DATABASE_URL=sqlite:///./linguaflow.db

# Apple App Store Server API / StoreKit 2
APPLE_ENVIRONMENT=sandbox
APPLE_BUNDLE_ID=com.example.linguaflow
APPLE_APPLE_ID=
APPLE_ROOT_CERT_PATH=/var/www/linguaflow/certs/apple-root-ca.cer
APPLE_MONTHLY_PRODUCT_ID=com.bulutaltundis.linguaflow.superlinguaflow.monthly
APPLE_YEARLY_PRODUCT_ID=com.bulutaltundis.linguaflow.superlinguaflow.annual

# Existing Paddle values, if Paddle web checkout is also enabled
PADDLE_ENV=sandbox
PADDLE_CLIENT_TOKEN=test_replace_me
PADDLE_MONTHLY_PRICE_ID=pri_replace_me
PADDLE_YEARLY_PRICE_ID=pri_replace_me
PADDLE_WEBHOOK_SECRET=pdl_ntfset_replace_me
